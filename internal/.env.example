# Optional for local development. Required for production (npm start / Docker).
# Use a random value, shared only with authorized workspace users.
INTERNAL_ACCESS_TOKEN=

# Optional server-wide read-only Bitbucket connection.
# API token: set your Atlassian email and token with read:repository:bitbucket.
# Repository/workspace access token: leave BITBUCKET_EMAIL empty.
BITBUCKET_EMAIL=
BITBUCKET_TOKEN=

# If a reverse proxy changes the request origin, set the browser-visible HTTPS origin.
# Example: https://codemap.company.internal
INTERNAL_ORIGIN=
