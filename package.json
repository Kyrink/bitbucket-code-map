{
  "name": "gitdiagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:mcp-app && bun run --bun next build",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "cf:build": "bash scripts/cf-build.sh",
    "cf:deploy": "bash scripts/cf-deploy.sh",
    "cf:usage": "node scripts/cf-usage.mjs",
    "check": "bun run lint && bun run typecheck",
    "dev": "bun run build:mcp-app && ./scripts/dev-turbo.sh",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "preview": "next build && next start",
    "start": "next start",
    "quota:today": "bun scripts/complimentary-quota-today.mjs",
    "browse:migrate-index": "bun scripts/migrate-browse-index.ts",
    "diagram:delete": "bun scripts/delete-diagram.ts",
    "ai-visibility:run": "bun --conditions=react-server scripts/ai-visibility-run.ts",
    "indexnow:submit-sitemap": "bun scripts/indexnow-submit-sitemap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node_modules/typescript-7/bin/tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "perf:budget": "node scripts/check-performance-budgets.mjs",
    "check:video-tracing": "node scripts/check-video-render-tracing.mjs",
    "knip": "knip --reporter compact",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "internal:dev": "npm --prefix internal run dev",
    "internal:build": "npm --prefix internal run build",
    "internal:test": "npm --prefix internal test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@smithy/fetch-http-handler": "5.8.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "ffmpeg-static": "5.3.0",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "~16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.45.0",
    "posthog-js": "^1.438.24",
    "puppeteer-core": "25.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.28.8",
    "ajv": "6.15.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fflate": "0.4.9",
    "flatted": "3.4.4",
    "katex": "0.18.2",
    "lodash-es": "^4.18.1",
    "minimatch@<4": "3.1.5",
    "picomatch@<3": "2.3.2",
    "postcss": "8.5.31",
    "rollup": "4.62.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "8.11.2",
    "vite": "7.3.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "~16.4.3",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "redis": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.5",
    "wrangler": "^4.153.0"
  },
  "knip": {
    "entry": [
      "src/mcp-app/diagram-view.ts",
      "open-next.config.ts",
      "scripts/cf-secrets.mjs",
      "scripts/cf-asset-headers.mjs",
      "scripts/cf-drop-proxy.mjs",
      "scripts/cf-routes.mjs",
      "scripts/cf-staging.mjs",
      "scripts/cf-container-image.mjs",
      "scripts/video-model-replay.mjs",
      "scripts/video-pipeline-test.mjs",
      "scripts/compare-hosts.mjs",
      "scripts/cf-usage.mjs",
      "scripts/bench.mjs"
    ],
    "ignore": [
      "experiments/**",
      "public/video-engine/**",
      "workers/**",
      "cloudflare/**"
    ],
    "ignoreDependencies": [
      "@cloudflare/containers",
      "@opennextjs/aws",
      "typescript-7",
      "wrangler"
    ],
    "ignoreBinaries": [
      "redis-server"
    ]
  },
  "engines": {
    "bun": ">=1.3.14 <2",
    "node": "22.x"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
    "minimatch@9.0.9": "patches/minimatch@9.0.9.patch"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
